# CaseCompass Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Google OAuth ---
# Get from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- JWT Session ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_HOURS=8

# --- Role Allowlists (comma-separated Google email addresses) ---
# Leave empty = no admins / judges from Google login
ADMIN_EMAILS=admin@yourdomain.com,another.admin@gmail.com
JUDGE_EMAILS=judge@yourdomain.com

# --- Demo Mode ---
# Set true ONLY for hackathon demos. Enables demo login with fictional data.
DEMO_MODE=false

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://casecompass-seven.vercel.app

# --- LLM Providers (optional) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=offline_rules

# --- n8n Webhook Secret (optional) ---
# Shared secret for HMAC-signed n8n webhook calls
N8N_WEBHOOK_SECRET=

# --- Legacy API Key (optional, for non-auth endpoints) ---
CASECOMPASS_API_KEY=

# --- Vite / Frontend ---
# These go in frontend/.env (not this file)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_API_BASE_URL=http://localhost:8000
