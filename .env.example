# CaseCompass Environment Configuration

# AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini # Options: "gemini", "openai", "offline_rules"

# System Execution Modes
RUNNING_WITHOUT_AI=false # If true, forces offline deterministic rules mode (Mode A)
OCR_LANGUAGE_PACKS=eng+mar+hin
VERIFICATION_FUZZY_THRESHOLD=0.95
MAX_OCR_PAGES=50

# Storage & Demo
DATA_DIR=data

# Security & API Authentication (X-API-Key)
CASECOMPASS_API_KEY=casecompass-secret-key-123
